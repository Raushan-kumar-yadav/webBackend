{
  "name": "geniwebbackend",
  "version": "1.0.0",
  "main": "dist/index.ts",
 "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && npx tsc-alias",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node dist/index.js",
    "drizzle": "drizzle-kit",
    "migrate:dev": "drizzle-kit migrate dev",
    "migrate:push": "drizzle-kit migrate push",
    "migrate:pull": "drizzle-kit migrate pull",
    "migrate:reset": "drizzle-kit migrate reset",
    "migrate:status": "drizzle-kit migrate status",
    "start:prod": "pm2 start dist/index.js --name geniwebbackend"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^2.0.2",
    "mysql2": "^3.15.1",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.6"
  }
}
